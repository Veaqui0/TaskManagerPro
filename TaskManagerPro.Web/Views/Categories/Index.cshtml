@model IEnumerable<TaskManagerPro.Web.Models.Category>

@{
    ViewData["Title"] = "Categorías";
}

<h1 class="mb-4">Categorías</h1>

<partial name="_Alert" />

<p>
    <a asp-action="Create" class="btn btn-primary">Nueva categoría</a>
</p>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(m => m.Name)</th>
            <th>@Html.DisplayNameFor(m => m.Description)</th>
            <th class="text-center">Tareas</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="4" class="text-center text-muted py-4">No hay categorías registradas.</td>
            </tr>
        }
        else
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(m => item.Name)</td>
                    <td>@Html.DisplayFor(m => item.Description)</td>
                    <td class="text-center">
                        <span class="badge bg-secondary">@item.Tasks.Count</span>
                    </td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>