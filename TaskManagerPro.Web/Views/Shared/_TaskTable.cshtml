@model IEnumerable<TaskManagerPro.Web.Models.TaskItem>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(m => m.Title)</th>
            <th>@Html.DisplayNameFor(m => m.Category)</th>
            <th>@Html.DisplayNameFor(m => m.DueDate)</th>
            <th class="text-center">@Html.DisplayNameFor(m => m.Priority)</th>
            <th class="text-center">@Html.DisplayNameFor(m => m.State)</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="6" class="text-center text-muted py-4">No hay tareas registradas.</td>
            </tr>
        }
        else
        {
            @foreach (var item in Model)
            {
                <tr class="@(item.IsOverdue() ? "table-danger" : "")">
                    <td>
                        @Html.DisplayFor(m => item.Title)
                        @if (item.IsOverdue())
                        {
                            <span class="badge bg-danger ms-2">Vencida</span>
                        }
                    </td>
                    <td>@Html.DisplayFor(m => item.Category!.Name)</td>
                    <td>@(item.DueDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                    <td class="text-center">
                        <span class="badge bg-@(item.Priority == TaskManagerPro.Web.Models.Priority.Alta ? "danger" : item.Priority == TaskManagerPro.Web.Models.Priority.Media ? "warning text-dark" : "secondary")">
                            @item.GetPriorityLabel()
                        </span>
                    </td>
                    <td class="text-center">
                        <span class="badge bg-info text-dark">@item.State</span>
                    </td>
                    <td class="text-end">
                        <button type="button" class="btn btn-sm btn-info btn-details" data-id="@item.Id">Detalles</button>
                        <form asp-action="ToggleComplete" asp-route-id="@item.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-success">@(item.IsCompleted ? "Reabrir" : "Completar")</button>
                        </form>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
